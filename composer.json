{
	"name": "thisanimus/wp-theme-timber-vite-acf",
	"description": "Starter theme to build a WP theme with Vite, Timber and ACF",
	"type": "wordpress-theme",
	"license": "MIT",
	"authors": [
		{
			"email": "andrew@deepspacerobots.com",
			"name": "thisanimus"
		}
	],
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org"
		}
	],
	"require": {
		"timber/timber": "^2.1",
		"palmiak/timber-acf-wp-blocks": "dev-master"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	},
	"autoload": {
		"psr-4": {
			"App\\": "timber",
			"Deepspace\\": "lib"
		}
	}
}
